# 诺瓦 Nova · 环境变量模板
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，不会入库。
# 本项目不自动读取 .env（零第三方依赖），请通过 shell 或系统环境变量注入。

# ── 鉴权密钥（生产环境必填）────────────────────────────────
# 签名凭证的 HMAC 密钥，需 ≥32 字节随机串。
# 生产环境（NODE_ENV=production）未配置将直接拒绝启动。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NOVA_AUTH_SECRET=

# ── 运行模式 ────────────────────────────────────────────────
# production：启用生产约束（鉴权密钥必填等）；本地开发可留空
NODE_ENV=

# ── 监听地址与端口 ──────────────────────────────────────────
# 以下为示例取值（本机自用的收紧配置），不是程序缺省值。
# 缺省见 server/main.js：DEFAULT_PORT=8787、DEFAULT_HOST=127.0.0.1。
PORT=8080
HOST=127.0.0.1

# ── 服务端数据存储 ──────────────────────────────────────────
# 留空时写入 server/data/nova-store.json；可指定独立 JSON 文件路径。
NOVA_STORE_FILE=
# 默认 0：旧单 JSON 布局。设为 1 启用分区布局：只写变化分区，manifest 原子提交。
# 启用后路径为 <NOVA_STORE_FILE>.manifest.json、<NOVA_STORE_FILE>.partitioned.json 与 <NOVA_STORE_FILE>.parts/；旧版本保留。
# 标记/manifest/parts 不一致时拒绝启动，避免静默读取过期旧 JSON。
NOVA_STORE_PARTITIONED=0
# 当前逻辑数据与分区磁盘总字节预算（含旧版本/孤儿 parts），默认 16 MiB。
NOVA_STORE_MAX_BYTES=16777216
# 匿名身份可创建的最大分区数，默认 1024。
NOVA_STORE_MAX_PARTITIONS=1024
# 共享存储锁等待上限（毫秒）；超时不自动删除无法确认归属的锁，需人工核实。
NOVA_STORE_LOCK_TIMEOUT_MS=5000
# 进程内重排草案与复核收据的总字节预算，超限按 FIFO 淘汰；单条过大直接拒绝。
NOVA_DRAFT_BUDGET_BYTES=8388608
NOVA_RECEIPT_BUDGET_BYTES=4194304

# ── HTTP 连接边界 ──────────────────────────────────────────
# Node 层默认：请求头 10s、完整请求 130s（兼容 LLM 120s 上限）、keep-alive 5s、最大 128 连接。
# 反向代理示例见 deploy/nginx.conf.example；这些值不改变 S3 的撤销接口不限流决策。
NOVA_HTTP_HEADERS_TIMEOUT_MS=10000
NOVA_HTTP_REQUEST_TIMEOUT_MS=130000
NOVA_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
NOVA_HTTP_MAX_CONNECTIONS=128

# ── 跨域与敏感输出 ──────────────────────────────────────────
# 精确 origin 白名单，逗号分隔；同源请求不需要 CORS 头，默认不放行任何跨源来源。
NOVA_ALLOWED_ORIGINS=
# file:// 的 Origin 为 null；默认关闭，确需跨源调用时显式设为 1。
NOVA_ALLOW_NULL_ORIGIN=
# CLI 敏感备份/审计输出根目录；未设置时默认 <store 目录>/nova-admin-output。
NOVA_ADMIN_BACKUP_DIR=

# ── 限流来源策略 ────────────────────────────────────────────
# 置于网关/反向代理之后时设为 1：按 X-Forwarded-For 最后一跳隔离限流桶。
# 不设则按 TCP 对端地址（不可伪造，代价是代理后所有访客共享一个桶）。
NOVA_TRUST_PROXY=

# ── LLM 理解与分析层（可选）────────────────────────────────
# 诺瓦的对话式澄清与计划拆解建议。三要素齐备才启用；缺任一项时
# 前端自动降级为现有关键词 + 表单流程，其余功能不受影响。
# 协议：OpenAI 兼容 /chat/completions，任何兼容服务商均可
#（如智谱 https://open.bigmodel.cn/api/paas/v4 + 免费模型 glm-4-flash）。
# key 只在服务端进程内使用，不进仓库、不下发前端。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次调用超时（毫秒），缺省 30000，上限 120000
LLM_TIMEOUT_MS=
# 发送给 LLM 的上下文请求字节上限，默认 256 KiB；超限在联网前拒绝。
NOVA_LLM_MAX_REQUEST_BYTES=262144
