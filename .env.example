# 诺瓦 Nova · 环境变量模板
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，不会入库。
# 本项目不自动读取 .env（零第三方依赖），请通过 shell 或系统环境变量注入。

# ── 鉴权密钥（生产环境必填）────────────────────────────────
# 签名凭证的 HMAC 密钥，需 ≥32 字节随机串。
# 生产环境（NODE_ENV=production）未配置将直接拒绝启动。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NOVA_AUTH_SECRET=

# ── 运行模式 ────────────────────────────────────────────────
# production：启用生产约束（鉴权密钥必填等）；本地开发可留空
NODE_ENV=

# ── 监听地址与端口 ──────────────────────────────────────────
# 以下为示例取值（本机自用的收紧配置），不是程序缺省值。
# 缺省见 server/main.js：DEFAULT_PORT=8787、DEFAULT_HOST=0.0.0.0。
PORT=8080
HOST=127.0.0.1

# ── 限流来源策略 ────────────────────────────────────────────
# 置于网关/反向代理之后时设为 1：按 X-Forwarded-For 最后一跳隔离限流桶。
# 不设则按 TCP 对端地址（不可伪造，代价是代理后所有访客共享一个桶）。
NOVA_TRUST_PROXY=

# ── LLM 理解与分析层（可选）────────────────────────────────
# 诺瓦的对话式澄清与计划拆解建议。三要素齐备才启用；缺任一项时
# 前端自动降级为现有关键词 + 表单流程，其余功能不受影响。
# 协议：OpenAI 兼容 /chat/completions，任何兼容服务商均可
#（如智谱 https://open.bigmodel.cn/api/paas/v4 + 免费模型 glm-4-flash）。
# key 只在服务端进程内使用，不进仓库、不下发前端。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 单次调用超时（毫秒），缺省 30000，上限 120000
LLM_TIMEOUT_MS=
