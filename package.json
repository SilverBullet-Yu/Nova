{
  "name": "nova",
  "version": "1.1.0",
  "private": true,
  "description": "诺瓦 Nova · 面向学生的日程助理 Demo（确定性引擎 + REST API，零第三方依赖）",
  "type": "commonjs",
  "main": "server/main.js",
  "scripts": {
    "start": "node server/main.js",
    "prestart": "node scripts/build-engine.js",
    "dev": "node --watch server/main.js",
    "test": "node --test \"test/*.test.js\"",
    "pretest": "node scripts/build-engine.js",
    "audit": "node scripts/css-audit.mjs",
    "check:engine": "node scripts/build-engine.js --check",
    "bench:replan": "node scripts/bench-replan.js",
    "bench:placement": "node scripts/bench-placement.js",
    "build:engine": "node scripts/build-engine.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
